# Bridge configuration. Copy to .env and fill in.
# The bridge reads .env from this directory first, then ~/.hermes/.env.
# Real environment variables always win.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Which model answers conversation turns. The default agent loop is far too slow
# for a wearable turn (2-20s); this fast model answers in ~1.4s.
GLASSES_FAST_MODEL=MiniMax-M3.1-Flash

# API key for that provider (used for the fast path).
MINIMAX_API_KEY=

# ---------------------------------------------------------------------------
# Speech to text
# ---------------------------------------------------------------------------
# Local faster-whisper server (recommended — ~0.45s, GPU).
GLASSES_STT_BASE=http://127.0.0.1:9001
# Groq is the fallback if the local server is unavailable.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Text to speech
# ---------------------------------------------------------------------------
# Local chatterbox-tts-api server.
GLASSES_TTS_BASE=http://127.0.0.1:4324
# Voice name, as installed on your TTS server.
GLASSES_TTS_VOICE=male_rickmorty
GLASSES_TTS_LANGUAGE=en

# ---------------------------------------------------------------------------
# Hermes agent (optional)
# ---------------------------------------------------------------------------
# When set, the bridge can also route turns through a Hermes agent, which gives
# the assistant memory and tool use — at the cost of much higher latency.
GLASSES_HERMES_BASE=http://127.0.0.1:6789
GLASSES_HERMES_KEY=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Where crash reports and scratch audio are written.
GLASSES_WORK_DIR=~/.glasses-bridge
# Port the bridge listens on.
GLASSES_BRIDGE_PORT=8790
